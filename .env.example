# Noms des variables uniquement — ne jamais mettre de vraies valeurs dans ce fichier ni dans le dépôt.
# Les secrets passent par les « secrets réseau » de l'environnement Claude ou un gestionnaire dédié.

# Shopify (app custom, permissions en lecture seule au départ)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Google (phase 6)
GOOGLE_CLOUD_PROJECT=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GA4_PROPERTY_ID=
MERCHANT_CENTER_ACCOUNT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# TrendTrack (API REST, seulement si l'usage hors MCP est nécessaire)
TRENDTRACK_API_KEY=

# E-mail (seulement si Brevo est retenu)
BREVO_API_KEY=
